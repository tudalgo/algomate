{
  "extends": [
    "config:recommended"
  ],
  "configMigration": true,
  "dependencyDashboard": {
    "enabled": true,
    "labels": ["dependency"]
  },
  "addLabels": [
    "dependency"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "src/main/kotlin/**/Dependency.kt"
      ],
      "datasourceTemplate": "maven",
      "matchStrings": [
        "[A-Z_]+\\s*\\(\\s*(?:group\\s*=\\s*)?\"(?<group>[^\"]+)\"\\s*,\\s*(?:artifactName\\s*=\\s*)?\"(?<artifactName>[^\"]+)\"\\s*,\\s*(?:version\\s*=\\s*)?\"(?<currentValue>[^\"]+)\"\\s*\\)\\s*[,;]"
      ],
      "depNameTemplate": "{{group}}:{{artifactName}}"
    }
  ]
}
